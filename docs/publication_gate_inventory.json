{
  "schema": "market-watch-publication-gate-inventory/v1",
  "decisions": {
    "KEEP": "Hard refusal of the specific invalid operation (eligibility, build, deploy or receipt). Protects frozen identity, numeric data, book identity, provenance, authorization or publication order.",
    "BECOME_ISSUE": "Never refuses publication. Affected part gets a truthful fallback or placeholder where needed and one deduplicated row in issues.json / Sources & Issues.",
    "REMOVE": "Deleted from the production path: cosmetic, wording, legacy count or fixed-input assertion. Deterministic fixed-input behaviour stays covered by unit tests."
  },
  "shared_modules": {
    "scripts/market_watch_launch/publication_checks.py": "Hard check_* and soft soft_* checks used by both editions.",
    "scripts/market_watch_launch/render_steps.py": "Hard/optional render-step runner with fallback and diagnostic.",
    "scripts/market_watch_launch/render_fallbacks.py": "Truthful placeholders that remove stale base-page content.",
    "scripts/market_watch_launch/publication_issues.py": "Issue schema v1, diagnostics, deterministic issues.json, release digest restamp."
  },
  "gates": [
    {"id": "eligibility.not_wanted", "path": "research", "where": "research_contract", "reasons": ["no_live_launch", "provider_not_acp", "mode_not_live", "production_publication_not_requested", "final_phase_published", "launch_not_live", "session_not_today", "final_phase_authorized", "newer_launch_exists", "research_already_published"], "decision": "KEEP", "note": "skip, not fail: research edition not wanted or superseded; publication order."},
    {"id": "launch.record", "path": "research", "where": "_load_launch", "reasons": ["invalid_launch_id", "launch_record_missing", "launch_record_mismatch"], "decision": "KEEP"},
    {"id": "freeze.stage_artifacts", "path": "research", "where": "_verify_artifact_hashes", "reasons": ["freeze_stage_not_succeeded", "stage_artifact_missing", "stage_artifact_hash_drift"], "decision": "KEEP"},
    {"id": "freeze.quality_gate", "path": "research", "where": "_verify_quality_gate", "reasons": ["quality_gate_not_pass"], "decision": "KEEP"},
    {"id": "freeze.binding_attestation", "path": "research", "where": "_verify_binding_and_attestation", "reasons": ["freeze_binding_missing", "remote_freeze_attestation_missing", "freeze_binding_mismatch", "launch_identity_mismatch", "remote_freeze_attestation_mismatch", "checkout_not_a_git_commit", "remote_freeze_commit_not_in_checkout", "remote_freeze_binding_changed_since_attestation", "checkout_differs_from_committed_attestation", "checkout_differs_from_committed_binding"], "decision": "KEEP"},
    {"id": "freeze.expected_identity", "path": "research", "where": "research_contract", "reasons": ["expected_review_mismatch", "expected_packet_mismatch", "freeze_time_invalid", "freeze_session_mismatch"], "decision": "KEEP"},
    {"id": "freeze.packet", "path": "research", "where": "_verify_packet / build_research_site", "reasons": ["frozen_packet_invalid", "frozen_packet_hash_mismatch", "frozen_market_state_missing", "frozen_market_state_invalid"], "decision": "KEEP", "note": "An explicitly absent market payload already publishes an unavailable market document (no prices)."},
    {"id": "freeze.staged_scores", "path": "research", "where": "_verify_lineage / prepare_overlay / _SCORES_CHECK", "reasons": ["staged_scores_missing", "staged_scores_hash_mismatch", "staged_history_missing", "overlay_scores_hash_mismatch", "render_step_failed:staged scores"], "decision": "KEEP"},
    {"id": "books.previous_dataset", "path": "research", "where": "_accepted_books", "reasons": ["previous_accepted_dataset_missing"], "decision": "KEEP"},
    {"id": "news.accepted_context", "path": "research", "where": "_accepted_news_context", "reasons": ["accepted_news_missing"], "decision": "BECOME_ISSUE", "note": "News sections become unavailable placeholders; no Last refreshed label may be shown."},
    {"id": "build.site_dir", "path": "research", "where": "build_research_site", "reasons": ["site_dir_not_empty"], "decision": "KEEP"},
    {"id": "static_base.v6_integrity", "path": "both", "where": "research_static_base.rebuild_v6_base / deploy-pages Rebuild v6 base", "reasons": ["v6 base64 byte count", "v6 html byte count", "v6 html sha256"], "decision": "KEEP"},
    {"id": "static_base.patch_already_present", "path": "both", "where": "apply_last24 / apply_temperature_inputs", "reasons": ["v6 base already contains v7 patch", "temperature score patch already present"], "decision": "REMOVE", "note": "Fixed-input; impossible on the SHA-pinned base. Unit tested."},
    {"id": "static_base.anchors", "path": "both", "where": "apply_last24 / apply_news_rollup / apply_temperature_inputs", "reasons": ["v6 patch anchors changed", "rolling-news anchors changed", "temperature score CSS anchor changed", "<key> country anchor changed"], "decision": "BECOME_ISSUE", "note": "Helpers default strict=True for parity tests; production CLIs and research_pages call with strict=False. Missing anchor skips that patch (per country for temperature inputs) with a diagnostic."},
    {"id": "static_base.counts", "path": "both", "where": "apply_last24 / apply_news_rollup / apply_temperature_inputs / assert_six_economies", "reasons": ["invalid last-24 item count", "last-24 patch missing needle", "invalid top-driver count", "invalid rolling digest count", "rolling digest metadata missing", "missing dated or undated news digest section", "expected 24 temperature dimensions", "temperature input evidence blocks changed", "six-economy extension missing needle"], "decision": "REMOVE"},
    {"id": "render.six_economies", "path": "both", "where": "apply_six_economy_dashboard.py", "decision": "KEEP", "note": "Fixed-input structure step; hard step, its post-greps are REMOVE."},
    {"id": "render.legacy_patches", "path": "both", "where": "apply_v10_us_cpi_context.py / apply_v11_refresh.py / apply_daily_refresh.py", "decision": "BECOME_ISSUE", "note": "Optional step, fallback legacy_patch_skipped (dated archive text only)."},
    {"id": "render.news_refresh", "path": "both", "where": "apply_overnight_news_refresh.py / sync_news_summary.py", "decision": "BECOME_ISSUE", "note": "Optional step, fallback news_unavailable removes stale base news; hard check_news_dates_not_overstated and check_no_stale_static_news still apply."},
    {"id": "render.stale_static_news", "path": "both", "where": "'Last refreshed 18 Sep 2026' check", "reasons": ["stale_news_survived"], "decision": "KEEP"},
    {"id": "render.news_html_assertion", "path": "both", "where": "assert_built_news_matches_context / assert_news_html / news_label_not_accepted_date", "decision": "BECOME_ISSUE", "note": "Replaced as a veto by check_news_dates_not_overstated (KEEP)."},
    {"id": "render.score_sources", "path": "both", "where": "validate_score_sources.py", "decision": "KEEP"},
    {"id": "render.score_recompute", "path": "both", "where": "_SCORES_CHECK / deploy-pages cmp temperature_scores.json", "decision": "KEEP"},
    {"id": "render.temperature_scores", "path": "both", "where": "apply_temperature_scores.py", "decision": "BECOME_ISSUE", "note": "Optional step, fallback scores_unavailable removes static base score values; score board is re-rendered from the score state by dashboard repair."},
    {"id": "render.temperature_score_greps", "path": "final", "where": "deploy-pages Apply live temperature scores greps", "reasons": ["24 score-detail drawers", "24 neutral anchor notes", "one live score overview", "Live 1–100 Score Board present", "stale Temperature Board / transition anchor / lineage-pinned / contributing − wording", "stale Michigan 47.8 SCORED narrative"], "decision": "REMOVE"},
    {"id": "render.country_detail", "path": "both", "where": "apply_country_detail.py", "decision": "BECOME_ISSUE", "note": "Per-country isolation; a failed country gets a local unavailable placeholder; whole-step fallback country_detail_unavailable."},
    {"id": "render.country_detail_greps", "path": "final", "where": "deploy-pages Apply Country Detail greps", "reasons": ["data-country present", "24 drawers", "What Matters Now", "stale petrol sentence", "wmn-quiet / wmn-finding"], "decision": "REMOVE"},
    {"id": "render.policy_meeting_prices", "path": "research", "where": "build_research_site frozen policy_meeting_prices overlay", "decision": "KEEP", "note": "Never shows meeting prices from after the freeze."},
    {"id": "market.frozen_snapshot", "path": "research", "where": "validate_snapshot(frozen) / public_snapshot", "reasons": ["frozen_market_state_invalid"], "decision": "KEEP"},
    {"id": "market.final_snapshot", "path": "final", "where": "Generate market-state JSON for Pages (validate_snapshot)", "decision": "KEEP", "note": "Already continue-on-error: an invalid packet is not published; Market Data shows an explicit load failure."},
    {"id": "render.market_data_tab", "path": "both", "where": "apply_market_data_tab.py + greps", "decision": "BECOME_ISSUE", "note": "node --check of the shipped script stays; greps REMOVE."},
    {"id": "render.trader_book_tab", "path": "both", "where": "apply_trader_book_tab.py", "decision": "BECOME_ISSUE", "note": "Tab insertion anchors stay hard; post-insert dashboard marker greps are REMOVE."},
    {"id": "render.trader_room_tab", "path": "both", "where": "apply_trader_room_tab.py", "decision": "BECOME_ISSUE", "note": "Tab insertion anchors stay hard; post-insert dashboard marker greps are REMOVE."},
    {"id": "books.publish_check", "path": "both", "where": "overnight_pipeline.py publish-check (--require-dataset on production final)", "decision": "KEEP", "note": "Dataset presence, assert_may_publish, invalid families, and trader/PM book emission stay hard."},
    {"id": "books.publish_check_news_html", "path": "both", "where": "publication_gate news freshness + assert_site_news_matches_accepted", "reasons": ["accepted public news is not fresh", "built dashboard is missing a visible Last refreshed timestamp", "built dashboard missing expected visible marker", "accepted public news headlines missing"], "decision": "BECOME_ISSUE", "note": "With --news-html-policy soft (deploy-pages and research_pages), records diagnostics instead of raising. check_news_dates_not_overstated and check_no_stale_static_news remain KEEP."},
    {"id": "render.trader_room", "path": "both", "where": "apply_trader_room_tab.py / trader_room_public.py / assert_published_trader_room / trader_room_packet_incomplete", "decision": "BECOME_ISSUE", "note": "Optional research-debate component: an unverifiable packet is published as available:false, never as authoritative."},
    {"id": "books.pm_packet", "path": "both", "where": "pm_layer.py publish / validate_public_packet", "decision": "KEEP"},
    {"id": "render.dashboard_repair", "path": "both", "where": "apply_dashboard_repair.py", "decision": "KEEP", "note": "Hard step (replaces the stale base tape). Releases, sources, brief and debate sub-renders are isolated inside it and become placeholders plus issues."},
    {"id": "repair.stale_tape", "path": "both", "where": "repaired tape region / stale base tape values", "reasons": ["repaired_tape_missing", "stale_tape_value"], "decision": "KEEP"},
    {"id": "repair.source_health_truth", "path": "both", "where": "source-health.json", "reasons": ["failed_source_given_success_time"], "decision": "KEEP"},
    {"id": "repair.source_health_launch", "path": "research", "where": "source-health.json", "reasons": ["source_health_not_this_launch", "source_health_check_time_missing"], "decision": "KEEP"},
    {"id": "repair.source_health_counts", "path": "both", "where": "source-health.json counts", "reasons": ["source_health_counts_mismatch"], "decision": "BECOME_ISSUE"},
    {"id": "repair.page_structure", "path": "both", "where": "validate_research_site / deploy-pages Apply dashboard repair", "reasons": ["navigation_missing", "country_jump_missing", "research_section_missing", "retired_navigation_present", "static_momentum_watch_survived", "calibration_anchor_label_missing", "score_ingestion_label_missing"], "decision": "BECOME_ISSUE"},
    {"id": "repair.wording", "path": "both", "where": "validate_research_site / deploy-pages", "reasons": ["forbidden_wording", "scoreboard_labeled_live", "calendar_unknown_dates_not_unavailable"], "decision": "REMOVE"},
    {"id": "repair.official_release_cache", "path": "final", "where": "deploy-pages official_release_cache.json checks", "decision": "BECOME_ISSUE", "note": "Optional schedule cache; never a deploy veto."},
    {"id": "edition.release_identity", "path": "research", "where": "validate_research_site", "reasons": ["release_missing", "release_identity_mismatch", "release_phase_mismatch", "release_claims_trader_cycle", "site_digest_mismatch", "release_headlines_mismatch"], "decision": "KEEP"},
    {"id": "edition.banner", "path": "both", "where": "stamp_html / validate_research_site", "reasons": ["edition_stamp_failed", "edition_banner_missing", "edition_banner_identity_missing"], "decision": "KEEP", "note": "Insertion falls back to after <body> when the topbar anchor is missing."},
    {"id": "edition.books_note", "path": "research", "where": "stamp_html / validate_research_site", "reasons": ["trader_book_pending_note_missing"], "decision": "KEEP", "note": "Previous books must be labeled previous; insertion has a fallback anchor."},
    {"id": "edition.panel_notes", "path": "research", "where": "stamp_html front/news notes", "reasons": ["news_age_note_missing", "previous_analysis_label_missing"], "decision": "BECOME_ISSUE"},
    {"id": "edition.headlines_panels", "path": "research", "where": "stamp_html / validate_research_site", "reasons": ["headlines_panel_missing", "headlines_panel_mismatch", "headlines_empty_state_missing", "previous_label_misapplied"], "decision": "BECOME_ISSUE", "note": "Missing anchor (the Nov 10 news-alert failure) inserts the panel at a fallback position or omits it with an issue."},
    {"id": "edition.headlines_items", "path": "research", "where": "validate_research_site", "reasons": ["headlines_items_mismatch"], "decision": "KEEP", "note": "Narrowed: every rendered headline id/url must belong to the frozen packet selection (no foreign headline). Exact count/order mismatch BECOME_ISSUE."},
    {"id": "edition.current_label", "path": "research", "where": "validate_research_site", "reasons": ["current_label_misapplied"], "decision": "KEEP", "note": "Narrowed: 'Current verified headlines' only inside the banner and headline panels. Exactly-once-per-panel count BECOME_ISSUE."},
    {"id": "edition.stale_news_current", "path": "research", "where": "validate_research_site", "reasons": ["stale_news_labeled_current"], "decision": "KEEP"},
    {"id": "books.research_identity", "path": "research", "where": "validate_research_site", "reasons": ["trader_books_edition_missing", "trader_books_presented_as_current", "trader_books_are_current_cycle", "trader_books_not_previous_accepted", "trader_books_dates_mismatch", "trader_books_roster_incomplete", "pm_books_edition_missing"], "decision": "KEEP"},
    {"id": "market.research_publication", "path": "research", "where": "validate_research_site", "reasons": ["market_state_not_frozen_packet", "market_state_invalid"], "decision": "KEEP"},
    {"id": "receipt.research", "path": "research", "where": "record_research_receipt / guard / production channel", "reasons": ["receipt_requires_production_research_release", "receipt_identity_mismatch", "receipt_requires_run_id", "deploy_requires_production_release", "production_channel_requires_main_actions_run"], "decision": "KEEP"},
    {"id": "order.monotonic", "path": "both", "where": "publication_release guard (build and fresh main before deploy)", "reasons": ["superseded_by_newer_publication", "publication_identity_conflict", "candidate_not_ranked"], "decision": "KEEP"},
    {"id": "final.bind_checkout", "path": "final", "where": "pages_dispatch bind-checkout / build_final_release", "decision": "KEEP"},
    {"id": "final.public_readback", "path": "both", "where": "verify-public (dataset read-back is Stage 08 contract)", "decision": "KEEP"},
    {"id": "issues.feed", "path": "both", "where": "publication_issues publish", "decision": "BECOME_ISSUE", "note": "Never a veto: an unbuildable feed is published as status unavailable."}
  ]
}
