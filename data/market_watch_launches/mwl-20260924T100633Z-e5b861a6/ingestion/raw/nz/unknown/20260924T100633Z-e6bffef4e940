rovider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20241220.pdf","meta":{"extension":"PDF","size":"642.8KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, December 2024: Retail to catch a break?","type":"download"}},"standalonecta_166377_577194399":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20241129.pdf","meta":{"extension":"PDF","size":"669.6KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, November 2024: Almost back at par","type":"download"}},"standalonecta_166377_862379646":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20241025.pdf","meta":{"extension":"PDF","size":"669.9KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, October 2024: Back to reality","type":"download"}},"standalonecta_633001_2243035":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20240202.pdf","meta":{"extension":"PDF","size":"776.4KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, January 2024: Still very subdued","type":"download"}},"standalonecta_copy":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20240328.pdf","meta":{"extension":"PDF","size":"649.1KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, March 2024: The R word","type":"download"}},"standalonecta_copy_c":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20240426.pdf","meta":{"extension":"PDF","size":"759.1KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, April 2024: Capital losses","type":"download"}},"standalonecta_copy_c_2003735572":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20240524.pdf","meta":{"extension":"PDF","size":"720.9KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, May 2024: Going the RBNZ’s way","type":"download"}},"standalonecta_copy_c_671375620":{":type":"anzconz/components/content/standalonecta","button":{"variation":"tertiary"},"dataLayer":{"category":"content","componentType":"body-cta"},"iconLeft":{"alt":"","provider":null,"src":null},"iconRight":{"alt":"","provider":null,"src":null},"link":{"dataLayer":{"category":"content"},"href":"/content/dam/anzconz/documents/economics-and-market-research/2024/ANZ-ConsumerConfidence-20240627.pdf","meta":{"extension":"PDF","size":"726.7KB"},"target":"_blank","title":"ANZ-Roy Morgan Consumer Confidence, June 2024: Still subterranean","type":"download"}},"text":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan consumer confidence rose another 1 point in February to 94.5, driven by a lift in perceptions of future conditions.&nbsp;Inflation expectations lifted for a second month, up from 4.3% to 4.5%.</p>\r\n"},"text_177771323_copy__111691812":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan consumer confidence rose 1 point in January to 93.6. Perceptions of current conditions jumped, but confidence about the future fell.&nbsp;Inflation expectations bounced back, lifting from 3.9% to 4.3%.</p>\r\n"},"text_2064119929":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence rose 5 points in July to 87.9. It’s still very low, but has clawed back about half the March-April fall that coincided with ‘recession’ headlines. The lift was driven by improving expectations rather than the here and now.</p>\r\n<p>Inflation expectations fell half a percent to 3.7%, the lowest since September 2020. Expected house price inflation dropped a full percent to 2.4%, back around levels prevailing a year ago.&nbsp;</p>\r\n"},"text_2064119929_copy":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence rose 4 points in August, on top of a 5-point lift last month. At 92.2 it is still well below its 10-year average (109), but also well off its lows. Both the current and future conditions indexes lifted, the latter by more. Inflation expectations ticked 0.1%pt higher to 3.8%. Expected house price inflation lifted from 2.4% to 2.8%.</p>\r\n"},"text_2064119929_copy_1060566049":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence rose 3 points in September, its third straight month of improvement. At 95.1 it is still well below par, but it’s at its highest level since January 2022. The lift was driven by expectations about the future, rather than views of the here and now.</p>\r\n<p>Inflation expectations were unchanged at 3.8%. Expected house price inflation lifted from 2.8% to 3.2%, led by the North Island.</p>\r\n"},"text_2064119929_copy_1358231894":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence fell 4 points in October to 91.2, following three months of improvement. Both the current and future conditions indexes declined. Inflation expectations were unchanged at 3.8%. Expected house price inflation lifted from 3.2% to 3.4%.</p>\r\n"},"text_2064119929_copy_798978143":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence jumped 9 points in November to 99.8. Both the current and future conditions indexes lifted markedly.</p>\r\n<p>Inflation expectations rose 0.2%pts to 4.0%. Expected house price inflation lifted from 3.4% to 3.7% and is trending higher.</p>\r\n"},"text_2064119929_copy_840471063":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence finally cracked triple figures in December, rising marginally from 99.8 to 100.2.</p>\r\n<p>In a welcome sign for retailers, there was another sharp lift in the proportion of households thinking it’s a good time to buy a major household item.</p>\r\n<p>Inflation expectations eased back 0.2%pts to 3.8%, where they’ve spent four of the past five months.</p>\r\n"},"text_copy":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>The steady improvement in consumer confidence over recent months took a blow this month. ANZ-Roy Morgan consumer confidence fell 9 points in March to 86.4, with a fall across most questions, likely affected by recession headlines. Late-month responses were markedly weaker than those that preceded the GDP data. Inflation expectations were unchanged at 4.5%, while expected house price inflation fell from 4.1% to 3.4%. This series has no predictive power for house prices, but is a lens on the “wealth effect” on spending.</p>\r\n"},"text_copy_copy":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>Consumer confidence deteriorated in April, led by a pessimistic turn in the forward-looking components of the survey. ANZ-Roy Morgan Consumer Confidence fell 4 points to 82.1, close to lows seen during the Global Financial Crisis, but still slightly above the more recent pandemic lows. Wellington led the monthly deterioration in confidence and is the most downbeat region overall, with the lowest inflation expectations and the second-lowest willingness to buy a major household item. Nationwide, inflation expectations eased from 4.5% to 4.4%, while expected house price inflation lifted from 3.4% to 3.5%.&nbsp;</p>\r\n"},"text_copy_copy_copy":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence lifted 4 points in May, perhaps as the shock of the “recession” headlines wore off somewhat. That said, 84.9 is a very weak level, with the historical average sitting above 110. Possibly also contributing to the lift in confidence, inflation expectations eased from 4.4% to 3.8%, the lowest read since October 2020. Expected house price inflation eased from 3.5% to 3.2%.</p>\r\n"},"text_copy_copy_copy_":{":type":"anzconz/components/text","dataLayer":{"componentType":"body-link"},"richText":true,"text":"<p>ANZ-Roy Morgan Consumer Confidence eased 2 points in June. At 83, confidence is miles below the 20-year average of 114. Inflation expectations bounced from 3.8% back up to 4.2%. It’s volatile, but gradually trending lower. Expected house price inflation ticked up from 3.2% to 3.4%.</p>\r\n"},"title":{":type":"anzconz/components/title","anchor":"title_296852493","contentID":"title_296852493","title":"2024 editions","variation":"H2"},"title_1170225570_cop":{":type":"anzconz/components/title","anchor":"title_1106817529","contentID":"title_1106817529","title":"February 2024","variation":"H3"},"title_1170225570_cop_1247964551":{":type":"anzconz/components/title","anchor":"title_962412916","contentID":"title_962412916","title":"May 2024","variation":"H3"},"title_1170225570_cop_1514040138":{":type":"anzconz/components/title","anchor":"title_274376903","contentID":"title_274376903","title":"April 2024","variation":"H3"},"title_1170225570_cop_363482971":{":type":"anzconz/components/title","anchor":"title_1997307037","contentID":"title_1997307037","title":"January 2024","variation":"H3"},"title_1170225570_cop_691120503":{":type":"anzconz/components/title","anchor":"title_63124929","contentID":"title_63124929","title":"March 2024","variation":"H3"},"title_1170225570_cop_769007747":{":type":"anzconz/components/title","anchor":"title_29246555","contentID":"title_29246555","title":"June 2024","variation":"H3"},"title_66608087":{":type":"anzconz/components/title","anchor":"title_658799231","contentID":"title_658799231","title":"July 2024","variation":"H3"},"title_66608087_copy":{":type":"anzconz/components/title","anchor":"title_1005519889","contentID":"title_10055198