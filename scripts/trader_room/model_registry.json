{
  "schema_version": 1,
  "source": "repository Cursor model-routing surfaces",
  "validated_against": [
    ".cursor/hooks/enforce-subagent-models.sh",
    ".cursor/agents/*.md frontmatter",
    "docs/TRADER_ROOM_PROTOCOL.md"
  ],
  "notes": [
    "Exact IDs are taken from the current repository hook/agent catalog, not guessed from marketing names.",
    "Cursor custom-agent frontmatter uses grok-4.6[] (empty thinking-level parameter), which routes to grok-4.6.",
